#======================================================================
# IDE AND OS HARDWARE/SOFTWARE SYSTEM FILES
#======================================================================
.DS_Store
Thumbs.db
Icon?
*~
*.bak
*.swp
*.patch
*.log

#======================================================================
# VISUAL STUDIO CODE (VS Code Workspace Settings)
#======================================================================
# Ignore internal database and cache for both projects
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/ipch/
.history/

# NOTE: We do NOT ignore launch.json here because your custom 
# DAPLink debug configuration is critical for working with the repo!

#======================================================================
# PLATFORMIO (Global rules for all subprojects)
#======================================================================
# This safely catches .pio folders in both firmware_stm32 and firmware_esp32
**/.pio/
**/.pioenvs/
**/.piolibdeps/

#======================================================================
# COMPILER ARTIFACTS AND HEAVY TOOLS
#======================================================================
*.o
*.d
*.crf
*.lnp
*.axf
*.htm
*.dep
*.map
*.lst

# Isolate local openocd toolchain from repository
**/tool-openocd/

#======================================================================
# DATA AND LOGS (Ultrasound and DSP raw data)
#======================================================================
*.bin
*.hex
*.elf
*.csv
*.xlsx
dumps/
logs/

# Ignore local automation scripts
translate_comments.py
